<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- фон и окантовка отдельными слоями: их цвет и прозрачность задаются в настройках приложения -->
    <ImageView
        android:id="@+id/widget_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <ImageView
        android:id="@+id/widget_bg_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_add"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="Добавить задачу"
                android:padding="7dp"
                android:src="@drawable/widget_add" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- свободное место под списком: нажатие открывает раздел в приложении -->
            <FrameLayout
                android:id="@+id/widget_rest"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- список занимает только высоту своих строк, остальное достаётся widget_rest -->
            <ListView
                android:id="@+id/widget_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:dividerHeight="0dp" />

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Задач нет"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
